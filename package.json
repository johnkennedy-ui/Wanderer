{
  "name": "wanderer-browser-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:architecture": "node src/tests/architecture-guard.mjs",
    "build": "vite build",
    "test:browser": "npm run build && playwright test",
    "format": "prettier --write \"src/**/*.{ts,mjs,css}\" \"*.{ts,json,md}\" \"Documentation~/*.md\"",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/three": "^0.179.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
