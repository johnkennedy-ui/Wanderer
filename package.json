{
  "name": "wanderer-browser-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "vite",
    "format:check": "node scripts/agent/format.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:soak": "vitest run src/tests/domain/session-soak.test.ts src/tests/domain/session-runtime-bounds.test.ts src/tests/domain/session-world-runtime.test.ts",
    "check:architecture": "node src/tests/architecture-guard.mjs",
    "build": "vite build && node scripts/security/artifact.mjs create",
    "preview": "node scripts/agent/browser-preview.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run test && npm run check:architecture && npm run check:ci-policy && npm run build",
    "test:browser": "node scripts/agent/browser-test.mjs",
    "format": "node scripts/agent/format.mjs --write",
    "agent:mission-start": "node scripts/agent/mission-start.mjs",
    "agent:status": "node scripts/agent/status.mjs",
    "agent:run": "node scripts/agent/run.mjs",
    "agent:check": "node scripts/agent/check.mjs",
    "agent:evidence": "node scripts/agent/evidence.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "check:ci-policy": "node scripts/ci/policy.mjs",
    "test:ci-policy": "vitest run src/tests/agent/ci-policy.test.ts",
    "security:check": "node scripts/security/check.mjs",
    "agent:doctor": "node scripts/agent/doctor.mjs",
    "agent:finish": "node scripts/agent/finish.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/three": "^0.179.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vite": "^7.1.3",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "vite": "$vite",
    "plist": {
      "@xmldom/xmldom": "0.9.12"
    }
  }
}
